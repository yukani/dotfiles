syntax on
set number
set textwidth=0
set showmatch

set hlsearch
set smartcase
set ignorecase

set autoindent
set shiftwidth=4
set smartindent
set smarttab
set softtabstop=4
set expandtab
set tabstop=8
set softtabstop=8

set ruler
set directory^=$HOME/.vim/swap//

autocmd FileType tex setlocal nowrap
