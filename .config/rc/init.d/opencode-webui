#!/sbin/openrc-run

pidfile="${XDG_RUNTIME_DIR}/opencode-webui.pid"

start() {
    ebegin "Starting ${RC_SVCNAME}"
    start-stop-daemon \
        --start \
        --background \
        --make-pidfile \
        --pidfile "${pidfile}" \
        --exec "/usr/bin/opencode" -- "web"
    eend $?
}

stop() {
    ebegin "Stopping ${RC_SVCNAME}"
    start-stop-daemon --stop --pidfile "${pidfile}"
    eend $?
}
